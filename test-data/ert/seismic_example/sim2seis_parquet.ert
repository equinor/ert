QUEUE_SYSTEM LOCAL
QUEUE_OPTION LOCAL MAX_RUNNING 50

RUNPATH sim2seisparquet_out/realization-<IENS>/iter-<ITER>

NUM_REALIZATIONS 10
MIN_REALIZATIONS 1

RANDOM_SEED 1234

GEN_KW COEFFS coeff_priors

INSTALL_JOB mock_sim2seis MOCK_SIM2SEIS
FORWARD_MODEL mock_sim2seis(<FORMAT>=parquet)

SEISMIC share/results/tables/horizon--amplitude_full_mean_depth--20250101_20240101.parquet
SEISMIC share/results/tables/horizon--amplitude_full_mean_depth--20260101_20240101.parquet
SEISMIC share/results/tables/horizon--amplitude_full_min_depth--20250101_20240101.parquet
SEISMIC share/results/tables/horizon--amplitude_full_min_depth--20260101_20240101.parquet

OBS_CONFIG obs_parquet.txt
