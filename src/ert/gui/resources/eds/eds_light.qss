/*
 * Style sheet template following the Equinor Design System, used in light mode.
 * Copyright (c) 2020 Equinor ASA, MIT License (see LICENSE in this directory).
 * https://github.com/equinor/design-system
 *
 * Dollar-prefixed colour names are filled in from ert/gui/eds_colors.py.
 */

/* Window */
QFrame#central_widget { background: $LIGHT_GREY; }

Suggestor { background-color: $LIGHT_GREY; }
QScrollArea#suggestor_scroll,
QScrollArea#suggestor_scroll > QWidget,
QWidget#suggestor_messages {
    background-color: $LIGHT_GREY;
}

QFrame#side_frame {
    background-color: $WHITE;
    border-right: 2px solid $LIGHT_GREY;
}

/* Sidebar, mirrors the EDS SideBar.Link states */
QFrame#side_frame QToolButton {
    background-color: transparent;
    color: $TEXT_DEFAULT;
    border: 2px solid transparent;
    border-bottom-color: $LIGHT_GREY;
    border-radius: 0px;
    padding-top: 5px;
    padding-bottom: 10px;
}
QFrame#side_frame QToolButton:hover { background-color: $HEAVY_GREY; }
QFrame#side_frame QToolButton:checked,
QFrame#side_frame QToolButton:checked:hover {
    background-color: $SELECTED_HIGHLIGHT;
    color: $MEDIUM_GREEN;
}
QFrame#side_frame QToolButton:focus { border: 2px dashed $MEDIUM_GREEN; }
QFrame#side_frame QToolButton:disabled {
    background-color: $MEDIUM_GREY;
    color: $DARK_GREY;
}
QFrame#side_frame QToolButton::menu-indicator { right: 10px; bottom: 5px; }

/* Contained (primary) button */
QFrame#central_widget QToolButton#run_experiment {
    background-color: $MEDIUM_GREEN;
    color: $WHITE;
    border: none;
    border-radius: 4px;
    padding: 0px 16px 0px 12px;
    font-size: 14px;
    font-weight: 500;
}
QFrame#central_widget QToolButton#run_experiment:hover { background-color: $DARK_GREEN; }
QFrame#central_widget QToolButton#run_experiment:disabled {
    background-color: $MEDIUM_GREY;
    color: $DARK_GREY;
}

/* Outlined primary buttons, also used outside the main window */
QFrame#central_widget QPushButton,
QPushButton#copy_button {
    background-color: transparent;
    color: $MEDIUM_GREEN;
    border: 1px solid $MEDIUM_GREEN;
    border-radius: 4px;
    padding: 4px 12px;
}
QFrame#central_widget QPushButton:hover,
QPushButton#copy_button:hover {
    background-color: $LIGHT_GREEN;
    border-color: $DARK_GREEN;
}
QFrame#central_widget QPushButton:disabled,
QPushButton#copy_button:disabled {
    background-color: transparent;
    color: $DARK_GREY;
    border-color: $HEAVY_GREY;
}

/* Select */
QFrame#central_widget QComboBoxWithDescription {
    background-color: $MEDIUM_GREY;
    color: $TEXT_DEFAULT;
    border: none;
    border-bottom: 1px solid $TEXT_TERTIARY;
    border-radius: 0px;
    padding: 0px 8px;
    min-height: 36px;
}
QFrame#central_widget QComboBoxWithDescription:hover { background-color: $HEAVY_GREY; }
QFrame#central_widget QComboBoxWithDescription:focus, QFrame#central_widget QComboBoxWithDescription:on {
    border-bottom: 2px solid $MEDIUM_GREEN;
}
QFrame#central_widget QComboBoxWithDescription::drop-down { border: none; width: 32px; }
QFrame#central_widget QComboBoxWithDescription::down-arrow {
    image: url(img:arrow_drop_down.svg);
    width: 24px;
    height: 24px;
}
QFrame#central_widget QComboBoxWithDescription QAbstractItemView {
    background-color: $WHITE;
    border: none;
    outline: none;
}

/* Summary and settings cards */
SummaryPanel { background: transparent; border: none; }
QScrollArea#summary_card_scroll,
QScrollArea#summary_card_scroll > QWidget > QWidget { background: transparent; }

QFrame#card {
    background: $WHITE;
    border: none;
    border-radius: 4px;
}

QFrame#card StringBox,
QFrame#card QAbstractSpinBox {
    background-color: $INPUT_BACKGROUND;
    color: $TEXT_DEFAULT;
    placeholder-text-color: $TEXT_TERTIARY;
    border: none;
    border-bottom: 1px solid $INPUT_BORDER;
    border-radius: 0px;
    padding: 2px 4px;
}
QFrame#card StringBox:focus,
QFrame#card QAbstractSpinBox:focus { border-bottom: 2px solid $FOCUS; }
QFrame#card StringBox:disabled,
QFrame#card QAbstractSpinBox:disabled { color: $TEXT_TERTIARY; }
StringBox[invalid="true"],
QFrame#card StringBox[invalid="true"] {
    background-color: $RED_BACKGROUND;
    border-bottom: 2px solid $RED_TEXT;
}

/* Accordion */
Accordion QPushButton#accordion_header {
    background-color: $WHITE;
    color: $TEXT_DEFAULT;
    border: none;
    border-bottom: 1px solid $HEAVY_GREY;
    border-radius: 0px;
    padding: 0px 16px;
    text-align: left;
    font-size: 16px;
    font-weight: 500;
}
Accordion QPushButton#accordion_header:hover {
    background-color: $LIGHT_GREY;
}
Accordion QPushButton#accordion_header:checked {
    color: $MEDIUM_GREEN;
}
Accordion QPushButton#accordion_header:disabled {
    color: $DARK_GREY;
    border-color: $HEAVY_GREY;
}

/* Table, compact density */
QTableWidget#update_strategy_summary_widget {
    background: $WHITE;
    border: none;
    color: $TEXT_DEFAULT;
    gridline-color: transparent;
}
QTableWidget#update_strategy_summary_widget::item {
    padding: 0 16px;
    border-bottom: 1px solid $HEAVY_GREY;
}
QTableWidget#update_strategy_summary_widget::item:hover {
    background: $MEDIUM_GREY;
}
QTableWidget#update_strategy_summary_widget QHeaderView::section {
    background: $LIGHT_GREY;
    border: none;
    border-bottom: 2px solid $HEAVY_GREY;
    padding: 0 16px;
    min-height: 32px;
    color: $TEXT_DEFAULT;
}
QTableWidget#update_strategy_summary_widget QComboBox {
    background-color: $INPUT_BACKGROUND;
    color: $TEXT_DEFAULT;
    border: none;
    border-bottom: 1px solid $INPUT_BORDER;
    border-radius: 0px;
    padding: 0px 8px;
    min-height: 35px;
}
QTableWidget#update_strategy_summary_widget QComboBox:focus,
QTableWidget#update_strategy_summary_widget QComboBox:on {
    border-bottom: 2px solid $FOCUS;
}
QTableWidget#update_strategy_summary_widget QComboBox::drop-down {
    border: none;
    width: 32px;
}
QTableWidget#update_strategy_summary_widget QComboBox::down-arrow {
    image: url(img:arrow_drop_down.svg);
    width: 24px;
    height: 24px;
}
QTableWidget#update_strategy_summary_widget QComboBox QAbstractItemView {
    background-color: $INPUT_BACKGROUND;
    color: $TEXT_DEFAULT;
    border: none;
    outline: none;
}

/* Suggestor */
Suggestor QPushButton[variant="primary"] {
    background-color: $MEDIUM_GREEN;
    color: $TEXT_ON_ACCENT;
    border-radius: 4px;
    border: 2px solid $MEDIUM_GREEN;
    height: 36px;
    padding: 0px 16px 0px 16px;
}
Suggestor QPushButton[variant="primary"]:hover {
    background: $DARK_GREEN;
    border: 2px solid $DARK_GREEN;
}

Suggestor QPushButton[variant="secondary"] {
    background-color: $LIGHT_GREY;
    color: $MEDIUM_GREEN;
    border-radius: 4px;
    border: 2px solid $MEDIUM_GREEN;
    height: 36px;
    padding: 0px 16px 0px 16px;
}
Suggestor QPushButton[variant="secondary"]:hover {
    background-color: $LIGHT_GREEN;
}

Suggestor QFrame#help_panel,
Suggestor QFrame#help_panel QFrame {
    background-color: $MEDIUM_GREY;
    border-radius: 4px;
    border: 2px solid $HEAVY_GREY;
}
Suggestor QFrame#help_panel QFrame[frameShape="4"] {
    color: $HEAVY_GREY;
}
Suggestor QFrame#help_panel QLabel#help_header {
    font-size: 24px;
    color: $BLUE_TEXT;
    border: none;
    margin-left: 30px;
}
Suggestor QFrame#help_panel QPushButton[variant="link"] {
    background-color: $MEDIUM_GREY;
    color: $BLUE_TEXT;
    border: 0px solid white;
    margin-left: 34px;
    height: 36px;
    text-decoration: underline;
    text-align: left;
    font-size: 16px;
    padding: 0px;
}

QScrollArea#suggestor_scroll {
    border: none;
    width: 128px;
}
QScrollArea#suggestor_scroll QScrollBar {
    border: none;
    background-color: $LIGHT_GREY;
    width: 10px;
}
QScrollArea#suggestor_scroll QScrollBar::handle {
    border: none;
    background-color: $HEAVY_GREY;
    border-radius: 4px;
}
QScrollArea#suggestor_scroll QScrollBar::sub-line:vertical, QScrollArea#suggestor_scroll QScrollBar::add-line:vertical {
    background: none;
}

/* Plot side panels */
QWidget#plot_side_panel_titlebar, QWidget#plot_side_panel_body {
    background-color: $LIGHT_GREY;
}
QWidget#plot_side_panel_titlebar { border-bottom: 1px solid $HEAVY_GREY; }
QDockWidget#left_plot_side_panel QWidget#plot_side_panel_body {
    border-right: 1px solid $HEAVY_GREY;
}
QDockWidget#right_plot_side_panel QWidget#plot_side_panel_body {
    border-left: 1px solid $HEAVY_GREY;
}
