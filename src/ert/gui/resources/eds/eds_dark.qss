 * Copyright (c) 2020 Equinor ASA, MIT License (see LICENSE in this directory).
 * https://github.com/equinor/design-system
 *
 * Dollar-prefixed colour names are filled in from DARK_COLORS in
 * ert/gui/eds_colors.py.
 */

/* Window and cards: the surface is darker than the canvas */
QFrame#central_widget { background: $LIGHT_GREY; }

SummaryPanel { background: transparent; border: none; }
QScrollArea#summary_card_scroll,
QScrollArea#summary_card_scroll > QWidget > QWidget { background: transparent; }

QFrame#card {
    background: $WHITE;
    border: none;
    border-radius: 4px;
}

QFrame#card StringBox,
QFrame#card QAbstractSpinBox {
    background-color: $INPUT_BACKGROUND;
    color: $TEXT_DEFAULT;
    placeholder-text-color: $TEXT_TERTIARY;
    border: none;
    border-bottom: 1px solid $INPUT_BORDER;
    border-radius: 0px;
    padding: 2px 4px;
}
QFrame#card StringBox:focus,
QFrame#card QAbstractSpinBox:focus { border-bottom: 2px solid $FOCUS; }
QFrame#card StringBox:disabled,
QFrame#card QAbstractSpinBox:disabled { color: $TEXT_TERTIARY; }
StringBox[invalid="true"],
QFrame#card StringBox[invalid="true"] {
    background-color: $RED_BACKGROUND;
    border-bottom: 2px solid $RED_TEXT;
}

QTableWidget#update_strategy_summary_widget QComboBox {
    background-color: $INPUT_BACKGROUND;
    color: $TEXT_DEFAULT;
    border: none;
    border-bottom: 1px solid $INPUT_BORDER;
    border-radius: 0px;
    padding: 0px 8px;
    min-height: 35px;
}
QTableWidget#update_strategy_summary_widget QComboBox:focus,
QTableWidget#update_strategy_summary_widget QComboBox:on {
    border-bottom: 2px solid $FOCUS;
}
QTableWidget#update_strategy_summary_widget QComboBox::drop-down {
    border: none;
    width: 32px;
}
QTableWidget#update_strategy_summary_widget QComboBox::down-arrow {
    image: url(img:arrow_drop_down_light.svg);
    width: 24px;
    height: 24px;
}
QTableWidget#update_strategy_summary_widget QComboBox QAbstractItemView {
    background-color: $INPUT_BACKGROUND;
    color: $TEXT_DEFAULT;
    border: none;
    outline: none;
}

/* Contained (primary) button */
QToolButton#run_experiment {
    background-color: $MEDIUM_GREEN;
    color: $TEXT_ON_ACCENT;
    border: none;
    border-radius: 4px;
    padding: 0px 16px 0px 12px;
    font-size: 14px;
    font-weight: 500;
}
QToolButton#run_experiment:hover { background-color: $DARK_GREEN; }
QToolButton#run_experiment:disabled {
    background-color: $MEDIUM_GREY;
    color: $DARK_GREY;
}

/* Outlined primary buttons, also used outside the main window */
QFrame#central_widget QPushButton,
QPushButton#copy_button {
    background-color: transparent;
    color: $MEDIUM_GREEN;
    border: 1px solid $MEDIUM_GREEN;
    border-radius: 4px;
    padding: 4px 12px;
}
QFrame#central_widget QPushButton:hover,
QPushButton#copy_button:hover {
    background-color: $LIGHT_GREEN;
    border-color: $DARK_GREEN;
}
QFrame#central_widget QPushButton:disabled,
QPushButton#copy_button:disabled {
    background-color: transparent;
    color: $DARK_GREY;
    border-color: $HEAVY_GREY;
}

/* Suggestor */
Suggestor QPushButton[variant="primary"] {
    background-color: $MEDIUM_GREEN;
    color: $TEXT_ON_ACCENT;
    border-radius: 4px;
    border: 2px solid $MEDIUM_GREEN;
    height: 36px;
    padding: 0px 16px 0px 16px;
}
Suggestor QPushButton[variant="primary"]:hover {
    background: $DARK_GREEN;
    border: 2px solid $DARK_GREEN;
}

Suggestor QPushButton[variant="secondary"] {
    background-color: $LIGHT_GREY;
    color: $MEDIUM_GREEN;
    border-radius: 4px;
    border: 2px solid $MEDIUM_GREEN;
    height: 36px;
    padding: 0px 16px 0px 16px;
}
Suggestor QPushButton[variant="secondary"]:hover {
    background-color: $LIGHT_GREEN;
}

Suggestor QFrame#help_panel,
Suggestor QFrame#help_panel QFrame {
    background-color: $MEDIUM_GREY;
    border-radius: 4px;
    border: 2px solid $HEAVY_GREY;
}
Suggestor QFrame#help_panel QFrame[frameShape="4"] {
    color: $HEAVY_GREY;
}
Suggestor QFrame#help_panel QLabel#help_header {
    font-size: 24px;
    color: $BLUE_TEXT;
    border: none;
    margin-left: 30px;
}
Suggestor QFrame#help_panel QPushButton[variant="link"] {
    background-color: $MEDIUM_GREY;
    color: $BLUE_TEXT;
    border: 0px solid white;
    margin-left: 34px;
    height: 36px;
    text-decoration: underline;
    text-align: left;
    font-size: 16px;
    padding: 0px;
}

QScrollArea#suggestor_scroll {
    border: none;
    width: 128px;
}
QScrollArea#suggestor_scroll QScrollBar {
    border: none;
    background-color: $LIGHT_GREY;
    width: 10px;
}
QScrollArea#suggestor_scroll QScrollBar::handle {
    border: none;
    background-color: $HEAVY_GREY;
    border-radius: 4px;
}
QScrollArea#suggestor_scroll QScrollBar::sub-line:vertical, QScrollArea#suggestor_scroll QScrollBar::add-line:vertical {
    background: none;
}

/* Accordion */
Accordion QPushButton#accordion_header {
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 40);
    padding: 0px 16px;
    text-align: left;
    font-size: 16px;
    font-weight: 500;
}
Accordion QPushButton#accordion_header:hover {
    background-color: rgba(255, 255, 255, 20);
}

/* Plot side panels */
QWidget#plot_side_panel_titlebar, QWidget#plot_side_panel_body {
    background-color: $LIGHT_GREY;
}
QWidget#plot_side_panel_titlebar { border-bottom: 1px solid $HEAVY_GREY; }
QDockWidget#left_plot_side_panel QWidget#plot_side_panel_body {
    border-right: 1px solid $HEAVY_GREY;
}
QDockWidget#right_plot_side_panel QWidget#plot_side_panel_body {
    border-left: 1px solid $HEAVY_GREY;
}
